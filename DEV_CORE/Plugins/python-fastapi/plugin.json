{
  "manifest_version": 2,
  "id": "python-fastapi",
  "name": "Python FastAPI",
  "version": "0.1.0",
  "description": "Internal DEV_CORE plugin for Python FastAPI project workflows.",
  "devcore_min_version": "10.0.0",
  "devcore_max_version": "10.99.0",
  "entrypoint": {
    "type": "command",
    "command": "python-api:health"
  },
  "capabilities": {
    "commands": [
      "python-api:new-endpoint",
      "python-api:run-tests",
      "python-api:health"
    ],
    "hooks": [],
    "skills": [
      "python_api"
    ],
    "health_checks": [
      {
        "id": "python-version",
        "command": "python --version",
        "required": false,
        "timeout_seconds": 10,
        "description": "Check that Python is available on PATH."
      },
      {
        "id": "pytest-version",
        "command": "pytest --version",
        "required": false,
        "timeout_seconds": 10,
        "description": "Check that pytest is available for test workflows."
      }
    ],
    "widgets": [],
    "templates": [
      "fastapi-endpoint",
      "fastapi-service",
      "pytest-smoke"
    ]
  },
  "permissions": {
    "filesystem": {
      "read": [
        "workspace",
        "templates"
      ],
      "write": [
        "data",
        "cache",
        "templates"
      ]
    },
    "network": {
      "allow": []
    },
    "secrets": {
      "read": []
    },
    "process": {
      "allow": [
        "python",
        "pytest"
      ],
      "allow_shell": false
    }
  }
}
