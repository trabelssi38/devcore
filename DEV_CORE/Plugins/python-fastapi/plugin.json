{
  "schema_version": 1,
  "id": "python-fastapi",
  "name": "Python FastAPI",
  "version": "0.1.0",
  "description": "Internal DEV_CORE plugin for Python FastAPI project workflows.",
  "capabilities": {
    "commands": [
      "python-api:new-endpoint",
      "python-api:run-tests",
      "python-api:health"
    ],
    "hooks": [],
    "skills": [
      "python_api"
    ],
    "health_checks": [
      {
        "id": "python-version",
        "command": "python --version",
        "required": false,
        "timeout_seconds": 10,
        "description": "Check that Python is available on PATH."
      },
      {
        "id": "pytest-version",
        "command": "pytest --version",
        "required": false,
        "timeout_seconds": 10,
        "description": "Check that pytest is available for test workflows."
      }
    ],
    "widgets": [],
    "templates": [
      "fastapi-endpoint",
      "fastapi-service",
      "pytest-smoke"
    ]
  },
  "permissions": {
    "write_roots": [
      "data",
      "cache",
      "templates"
    ],
    "allow_out_of_scope_write": false
  }
}
