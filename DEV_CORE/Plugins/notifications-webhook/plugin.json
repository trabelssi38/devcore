{
  "manifest_version": 2,
  "id": "notifications-webhook",
  "name": "Notifications Webhook",
  "version": "0.1.0",
  "description": "Internal DEV_CORE plugin for Slack and Microsoft Teams webhook notifications.",
  "devcore_min_version": "10.0.0",
  "devcore_max_version": "10.99.0",
  "entrypoint": {
    "type": "command",
    "command": "notifications:health"
  },
  "capabilities": {
    "commands": [
      "notifications:send",
      "notifications:health"
    ],
    "hooks": [
      "task.done",
      "run.failed",
      "schedule.failed"
    ],
    "skills": [],
    "health_checks": [
      {
        "id": "notification-secrets",
        "command": "$ok = -not [string]::IsNullOrWhiteSpace($env:SLACK_WEBHOOK_URL) -or -not [string]::IsNullOrWhiteSpace($env:TEAMS_WEBHOOK_URL); if ($ok) { exit 0 } else { Write-Error 'SLACK_WEBHOOK_URL or TEAMS_WEBHOOK_URL is required'; exit 1 }",
        "required": false,
        "timeout_seconds": 10,
        "description": "Check that at least one notification webhook secret is configured."
      }
    ],
    "widgets": [],
    "templates": [
      "slack-message",
      "teams-message-card"
    ]
  },
  "permissions": {
    "filesystem": {
      "read": [
        "templates"
      ],
      "write": [
        "data",
        "logs"
      ]
    },
    "network": {
      "allow": [
        "hooks.slack.com:443",
        "outlook.office.com:443"
      ]
    },
    "secrets": {
      "read": [
        "SLACK_WEBHOOK_URL",
        "TEAMS_WEBHOOK_URL"
      ]
    },
    "process": {
      "allow": [
        "powershell"
      ],
      "allow_shell": false
    }
  }
}
