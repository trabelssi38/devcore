# Example only. Do not load over the current instance before L3-L9 cutover.
# Replace every placeholder with an absolute path validated on the target host.
DEVCORE_PLATFORM_ROOT=<absolute-code-root>/DEV_CORE
DEVCORE_LOCAL_ROOT=<absolute-local-non-dropbox-runtime-root>
DEVCORE_DATA_ROOT=<absolute-shared-documents-root>
DEVCORE_DASHBOARD_BIND=127.0.0.1
DEVCORE_ALLOW_PUBLIC_BIND=0
DEVCORE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:20129

# Qualification profile: scoped tasks and registered project context.
# Global Cockpit pages, projections, search and SSE are closed in this profile.
# Browser/password sessions are qualified on fixtures; PostgreSQL remains open.
DEVCORE_DASHBOARD_AUTH_PROFILE=individual
DEVCORE_IDENTITY_STORE=<absolute-local-non-dropbox-runtime-root>/Security/individual_identity.db
DEVCORE_HTTP_CONTEXT_MAX_BYTES=12000

# Keep credentials and encryption keys outside this file and outside Git.
# The shared documents root is not a transactional database location.
