{
  "components": {
    "schemas": {
      "ContractCatalog": {
        "properties": {
          "api_version": {
            "const": "v1",
            "default": "v1",
            "title": "Api Version",
            "type": "string"
          },
          "contracts": {
            "items": {
              "enum": [
                "Task",
                "Run",
                "Event",
                "Plugin",
                "Health",
                "User",
                "Organization",
                "Workspace",
                "WorkspaceMembership",
                "WorkspaceQuota"
              ],
              "type": "string"
            },
            "title": "Contracts",
            "type": "array"
          },
          "event": {
            "$ref": "#/components/schemas/DomainEvent"
          },
          "health": {
            "$ref": "#/components/schemas/HealthContract"
          },
          "organization": {
            "$ref": "#/components/schemas/OrganizationContract"
          },
          "plugin": {
            "$ref": "#/components/schemas/PluginContract"
          },
          "run": {
            "$ref": "#/components/schemas/RunContract"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "task": {
            "$ref": "#/components/schemas/TaskContract"
          },
          "user": {
            "$ref": "#/components/schemas/UserContract"
          },
          "workspace": {
            "$ref": "#/components/schemas/WorkspaceContract"
          },
          "workspace_membership": {
            "$ref": "#/components/schemas/WorkspaceMembershipContract"
          },
          "workspace_quota": {
            "$ref": "#/components/schemas/WorkspaceQuotaContract"
          }
        },
        "required": [
          "contracts",
          "task",
          "run",
          "event",
          "plugin",
          "health",
          "user",
          "organization",
          "workspace",
          "workspace_membership",
          "workspace_quota"
        ],
        "title": "ContractCatalog",
        "type": "object"
      },
      "DomainEvent": {
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "source": {
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "type": {
            "minLength": 1,
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "source"
        ],
        "title": "DomainEvent",
        "type": "object"
      },
      "GitHubWebhookAccepted": {
        "properties": {
          "accepted": {
            "const": true,
            "default": true,
            "title": "Accepted",
            "type": "boolean"
          },
          "delivery_id": {
            "minLength": 1,
            "title": "Delivery Id",
            "type": "string"
          },
          "event": {
            "minLength": 1,
            "title": "Event",
            "type": "string"
          },
          "provider": {
            "const": "github",
            "default": "github",
            "title": "Provider",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "event",
          "delivery_id"
        ],
        "title": "GitHubWebhookAccepted",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthContract": {
        "properties": {
          "checks": {
            "additionalProperties": true,
            "title": "Checks",
            "type": "object"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthContract",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "api_version": {
            "const": "v1",
            "default": "v1",
            "title": "Api Version",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "service": {
            "const": "devcore-api",
            "default": "devcore-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "trace_id": {
            "minLength": 1,
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "OrganizationContract": {
        "properties": {
          "id": {
            "pattern": "^org_[a-zA-Z0-9_-]+$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "default": "active",
            "enum": [
              "active",
              "archived",
              "suspended"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "OrganizationContract",
        "type": "object"
      },
      "PluginContract": {
        "properties": {
          "capabilities": {
            "additionalProperties": true,
            "title": "Capabilities",
            "type": "object"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "id": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "id",
          "name",
          "enabled"
        ],
        "title": "PluginContract",
        "type": "object"
      },
      "RunContract": {
        "properties": {
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "paused",
              "succeeded",
              "failed",
              "cancelled",
              "timed_out"
            ],
            "title": "Status",
            "type": "string"
          },
          "task_id": {
            "pattern": "^T-\\d+$",
            "title": "Task Id",
            "type": "string"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "required": [
          "id",
          "task_id",
          "status"
        ],
        "title": "RunContract",
        "type": "object"
      },
      "TaskContract": {
        "properties": {
          "id": {
            "pattern": "^T-\\d+$",
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "enum": [
              "reasoning",
              "coding",
              "bulk"
            ],
            "title": "Mode",
            "type": "string"
          },
          "project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "enum": [
              "todo",
              "active",
              "paused",
              "done",
              "skipped"
            ],
            "title": "Status",
            "type": "string"
          },
          "steps_done": {
            "default": 0,
            "minimum": 0.0,
            "title": "Steps Done",
            "type": "integer"
          },
          "steps_total": {
            "default": 1,
            "minimum": 1.0,
            "title": "Steps Total",
            "type": "integer"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "mode"
        ],
        "title": "TaskContract",
        "type": "object"
      },
      "TaskListResponse": {
        "properties": {
          "project": {
            "minLength": 1,
            "title": "Project",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/TaskContract"
            },
            "title": "Tasks",
            "type": "array"
          }
        },
        "required": [
          "project",
          "tasks"
        ],
        "title": "TaskListResponse",
        "type": "object"
      },
      "UserContract": {
        "properties": {
          "display_name": {
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
            "title": "Email",
            "type": "string"
          },
          "id": {
            "pattern": "^usr_[a-zA-Z0-9_-]+$",
            "title": "Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "default": "active",
            "enum": [
              "active",
              "disabled"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "display_name"
        ],
        "title": "UserContract",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WorkflowListResponse": {
        "properties": {
          "workflows": {
            "items": {
              "$ref": "#/components/schemas/WorkflowRunDetail"
            },
            "title": "Workflows",
            "type": "array"
          }
        },
        "required": [
          "workflows"
        ],
        "title": "WorkflowListResponse",
        "type": "object"
      },
      "WorkflowRunDetail": {
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "step_definitions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Step Definitions",
            "type": "array"
          },
          "steps": {
            "additionalProperties": {
              "$ref": "#/components/schemas/WorkflowStepState"
            },
            "title": "Steps",
            "type": "object"
          }
        },
        "required": [
          "run_id",
          "name",
          "status",
          "created_at",
          "step_definitions",
          "steps"
        ],
        "title": "WorkflowRunDetail",
        "type": "object"
      },
      "WorkflowStepState": {
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "output": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "starts_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Starts At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "WorkflowStepState",
        "type": "object"
      },
      "WorkspaceContract": {
        "properties": {
          "id": {
            "pattern": "^wks_[a-zA-Z0-9_-]+$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "organization_id": {
            "pattern": "^org_[a-zA-Z0-9_-]+$",
            "title": "Organization Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "default": "active",
            "enum": [
              "active",
              "archived",
              "suspended"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "organization_id",
          "name"
        ],
        "title": "WorkspaceContract",
        "type": "object"
      },
      "WorkspaceMembershipContract": {
        "properties": {
          "id": {
            "pattern": "^mem_[a-zA-Z0-9_-]+$",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "enum": [
              "owner",
              "admin",
              "developer",
              "viewer"
            ],
            "title": "Role",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "user_id": {
            "pattern": "^usr_[a-zA-Z0-9_-]+$",
            "title": "User Id",
            "type": "string"
          },
          "workspace_id": {
            "pattern": "^wks_[a-zA-Z0-9_-]+$",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "workspace_id",
          "user_id",
          "role"
        ],
        "title": "WorkspaceMembershipContract",
        "type": "object"
      },
      "WorkspaceQuotaContract": {
        "properties": {
          "model_tokens_per_day": {
            "minimum": 0.0,
            "title": "Model Tokens Per Day",
            "type": "integer"
          },
          "runs_per_day": {
            "minimum": 0.0,
            "title": "Runs Per Day",
            "type": "integer"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "storage_mb": {
            "minimum": 0.0,
            "title": "Storage Mb",
            "type": "integer"
          },
          "workspace_id": {
            "pattern": "^wks_[a-zA-Z0-9_-]+$",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "workspace_id",
          "runs_per_day",
          "model_tokens_per_day",
          "storage_mb"
        ],
        "title": "WorkspaceQuotaContract",
        "type": "object"
      }
