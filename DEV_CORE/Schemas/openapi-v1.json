{
  "components": {
    "schemas": {
      "ContractCatalog": {
        "properties": {
          "api_version": {
            "const": "v1",
            "default": "v1",
            "title": "Api Version",
            "type": "string"
          },
          "contracts": {
            "items": {
              "enum": [
                "Task",
                "Run",
                "Event",
                "Plugin",
                "Health"
              ],
              "type": "string"
            },
            "title": "Contracts",
            "type": "array"
          },
          "event": {
            "$ref": "#/components/schemas/DomainEvent"
          },
          "health": {
            "$ref": "#/components/schemas/HealthContract"
          },
          "plugin": {
            "$ref": "#/components/schemas/PluginContract"
          },
          "run": {
            "$ref": "#/components/schemas/RunContract"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "task": {
            "$ref": "#/components/schemas/TaskContract"
          }
        },
        "required": [
          "contracts",
          "task",
          "run",
          "event",
          "plugin",
          "health"
        ],
        "title": "ContractCatalog",
        "type": "object"
      },
      "DomainEvent": {
        "properties": {
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "source": {
            "minLength": 1,
            "title": "Source",
            "type": "string"
          },
          "type": {
            "minLength": 1,
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "source"
        ],
        "title": "DomainEvent",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthContract": {
        "properties": {
          "checks": {
            "additionalProperties": true,
            "title": "Checks",
            "type": "object"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "enum": [
              "ok",
              "degraded",
              "down"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthContract",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "api_version": {
            "const": "v1",
            "default": "v1",
            "title": "Api Version",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "service": {
            "const": "devcore-api",
            "default": "devcore-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "trace_id": {
            "minLength": 1,
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PluginContract": {
        "properties": {
          "capabilities": {
            "additionalProperties": true,
            "title": "Capabilities",
            "type": "object"
          },
          "enabled": {
            "title": "Enabled",
            "type": "boolean"
          },
          "id": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "required": [
          "id",
          "name",
          "enabled"
        ],
        "title": "PluginContract",
        "type": "object"
      },
      "RunContract": {
        "properties": {
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "id": {
            "minLength": 1,
            "title": "Id",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "timed_out"
            ],
            "title": "Status",
            "type": "string"
          },
          "task_id": {
            "pattern": "^T-\\d+$",
            "title": "Task Id",
            "type": "string"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trace Id"
          }
        },
        "required": [
          "id",
          "task_id",
          "status"
        ],
        "title": "RunContract",
        "type": "object"
      },
      "TaskContract": {
        "properties": {
          "id": {
            "pattern": "^T-\\d+$",
            "title": "Id",
            "type": "string"
          },
          "mode": {
            "enum": [
              "reasoning",
              "coding",
              "bulk"
            ],
            "title": "Mode",
            "type": "string"
          },
          "project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "status": {
            "enum": [
              "todo",
              "active",
              "paused",
              "done",
              "skipped"
            ],
            "title": "Status",
            "type": "string"
          },
          "steps_done": {
            "default": 0,
            "minimum": 0.0,
            "title": "Steps Done",
            "type": "integer"
          },
          "steps_total": {
            "default": 1,
            "minimum": 1.0,
            "title": "Steps Total",
            "type": "integer"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "mode"
        ],
        "title": "TaskContract",
        "type": "object"
      },
      "TaskListResponse": {
        "properties": {
          "project": {
            "minLength": 1,
            "title": "Project",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/TaskContract"
            },
            "title": "Tasks",
            "type": "array"
          }
        },
        "required": [
          "project",
          "tasks"
        ],
        "title": "TaskListResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "DEV_CORE API Gateway",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/contracts": {
      "get": {
        "operationId": "contracts_api_v1_contracts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContractCatalog"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Contracts",
        "tags": [
          "contracts"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/tasks": {
      "get": {
        "operationId": "list_tasks_api_v1_tasks_get",
        "parameters": [
          {
            "in": "query",
            "name": "project",
            "required": false,
            "schema": {
              "default": "devcore",
              "title": "Project",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Tasks",
        "tags": [
          "tasks"
        ]
      }
    }
  }
}
