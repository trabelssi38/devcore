#!/bin/sh
# post-commit -- DEV_CORE v7 -- Event-driven & Robust
PLATFORM_ROOT="${DEVCORE_PLATFORM_ROOT:-C:/devcore/DEV_CORE}"
DATA_ROOT="${DEVCORE_DATA_ROOT:-C:/devcore/DEV_CORE_DATA}"
SCRIPTS="$PLATFORM_ROOT/Scripts"
MSG=$(git log -1 --pretty=%B)
TID=$(echo "$MSG" | grep -oP '\[T-\d+\]' | tr -d '[]' | head -1)

# 1. Step increment et renommage immédiat (si tag présent), sinon création autonome
if [ -n "$TID" ]; then
    echo "  [DEV_CORE] Tag $TID detecte dans le commit"
    powershell.exe -NoProfile -ExecutionPolicy Bypass -NonInteractive -Command "
    \$projName = & '$SCRIPTS/Get-ActiveProject.ps1'
    \$f = \"$DATA_ROOT/Memory/\$projName/tasks.json\"
    if(-not(Test-Path \$f)){exit 0}
    \$b=Get-Content \$f -Raw -Encoding UTF8 | ConvertFrom-Json
    \$t=\$b.tasks|Where-Object{\$_.id -eq '$TID'}
    if(-not \$t){exit 0}
    
    # Renommer les taches generiques
    if (\$t.title -like 'Session de travail auto*') {
        \$cleanMsg = \"$MSG\" -replace '\[T-\d+\]', ''
        \$cleanMsg = \$cleanMsg.Trim()
        if (\$cleanMsg) {
            \$t.title = \$cleanMsg
            Write-Host \"  [DEV_CORE] Tache \$TID renommee en : \$cleanMsg\"
        }
    }
    
    \$cur=if(\$t.PSObject.Properties['steps_done']){\$t.steps_done}else{0}
    \$tot=if(\$t.PSObject.Properties['steps_total']){\$t.steps_total}else{1}
    \$new=[math]::Min(\$cur+1,\$tot)
    \$t|Add-Member -NotePropertyName 'steps_done' -NotePropertyValue \$new -Force
    if(\$new -ge \$tot){
        \$t.status = 'done'
        \$t|Add-Member -NotePropertyName 'completed_at' -NotePropertyValue (Get-Date -Format 'o') -Force
        Write-Host \"  [DEV_CORE] Tache '$TID' marquee done\"
    }
    \$b|ConvertTo-Json -Depth 10|Set-Content \$f -Encoding UTF8
    Write-Host \"  [DEV_CORE] Step \$new/\$tot enregistree pour '$TID'\"
    if(\$new -ge \$tot){
        & '$SCRIPTS/task_done.ps1' -Force
    }
    "
else
    # Si aucun tag T-XX n'est présent, créer de manière autonome une tâche DONE à partir du commit
    echo "  [DEV_CORE] Aucun tag detecte. Creation autonome d'une tache..."
    powershell.exe -NoProfile -ExecutionPolicy Bypass -NonInteractive -Command "
    \$projName = & '$SCRIPTS/Get-ActiveProject.ps1'
    \$f = \"$DATA_ROOT/Memory/\$projName/tasks.json\"
    if(-not(Test-Path \$f)){exit 0}
    \$b=Get-Content \$f -Raw -Encoding UTF8 | ConvertFrom-Json
    
    # Ignorer les messages trop courts ou de merge
    \$cleanMsg = \"$MSG\".Trim()
    if (\$cleanMsg.Length -lt 6 -or \$cleanMsg.StartsWith('Merge ')) {
        exit 0
    }
    
    # Trouver le prochain ID disponible
    \$maxId = 0
    foreach (\$task in \$b.tasks) {
        if (\$task.id -match 'T-(\d+)') {
            \$num = [int]\$Matches[1]
            if (\$num -gt \$maxId) { \$maxId = \$num }
        }
    }
    \$nextNum = \$maxId + 1
    \$nextId = \"T-\$nextNum\"
    
    # Découper le message de commit en lignes
    \$lines = @( (\$cleanMsg -split '\r?\n') | ForEach-Object { \$_.Trim() } | Where-Object { \$_ } )
    \$taskTitle = if (\$lines -is [string]) { \$lines } else { \$lines[0] }
    
    \$steps = @()
    if (\$lines.Count -gt 1) {
        \$stepId = 1
        for (\$i = 1; \$i -lt \$lines.Count; \$i++) {
            \$line = \$lines[\$i]
            if (\$line -match '^[\-\*\+\s]+(.+)') {
                \$stepTitle = \$Matches[1].Trim()
            } else {
                \$stepTitle = \$line
            }
            if (\$stepTitle) {
                \$steps += [PSCustomObject]@{
                    id = \$stepId
                    title = \$stepTitle
                    done = \$true
                }
                \$stepId++
            }
        }
    }
    
    if (\$steps.Count -eq 0) {
        \$steps = @(
            [PSCustomObject]@{ id = 1; title = \$taskTitle; done = \$true }
        )
    }
    
    \$stepsTotal = \$steps.Count
    \$stepsDone = \$steps.Count
    
    # Créer l'objet tâche
    \$newTask = [PSCustomObject]@{
        id = \$nextId
        title = \$taskTitle
        mode = 'coding'
        status = 'done'
        steps_total = \$stepsTotal
        steps_done = \$stepsDone
        depends_on = \$null
        source = 'git'
        worktree = 'main'
        details = \"**Tache creee de maniere autonome a partir du commit Git :**\`n- \$cleanMsg\"
        completed_at = (Get-Date -Format 'o')
        steps = \$steps
    }
    
    # Ajouter la tâche à la liste
    \$b.tasks += \$newTask
    
    # Ajouter à detected_from_git
    if (\$b.PSObject.Properties['detected_from_git']) {
        \$b.detected_from_git += \$nextId
    } else {
        \$b | Add-Member -NotePropertyName 'detected_from_git' -NotePropertyValue @(\$nextId) -Force
    }
    
    # Sauvegarder tasks.json
    \$b | ConvertTo-Json -Depth 10 | Set-Content \$f -Encoding UTF8
    Write-Host \"  [DEV_CORE] Tache autonome \$nextId creee avec succes : \$cleanMsg\"
    
    # Régénérer le dashboard
    python.exe '$SCRIPTS/gen_dashboard.py' | Out-Null
    "
fi

# 2. Émettre l'événement post-commit pour le bus d'événements (Hermes)
echo "  [DEV_CORE] Emission evenement post-commit..."
powershell.exe -NoProfile -ExecutionPolicy Bypass -NonInteractive -Command "
\$eventBus = '$SCRIPTS/event_bus.ps1'
if (Test-Path \$eventBus) {
    \$commitMsg = (\$input | Out-String).Trim()
    \$commit = (git rev-parse HEAD).Trim()
    \$shortCommit = (git rev-parse --short=12 HEAD).Trim()
    \$project = (& '$SCRIPTS/Get-ActiveProject.ps1' | Select-Object -First 1).Trim()
    \$payload = @{
        commit = \$commit
        message = \$commitMsg
        task_id = '$TID'
    } | ConvertTo-Json -Depth 10 -Compress
    & \$eventBus -Action Publish -Id \"commit-\$shortCommit\" -Source 'post-commit' -Project \$project -TaskId '$TID' -EventType 'CommitCreated' -CorrelationId \$commit -PayloadJson \$payload -Json | Out-Null
}
" <<EOF
$MSG
EOF
powershell.exe -NoProfile -ExecutionPolicy Bypass -NonInteractive -Command "
\$evt = @{
    type = 'post-commit'
    timestamp = (Get-Date -Format 'o')
    commit_msg = (\$input | Out-String).Trim()
    task_id = '$TID'
} | ConvertTo-Json -Compress
\$evtDir = '$DATA_ROOT/Bus/events'
New-Item -ItemType Directory -Path \$evtDir -Force | Out-Null
Set-Content \"\$evtDir/\$(Get-Date -Format 'yyyyMMdd_HHmmss')_commit.json\" \$evt -Encoding UTF8
" <<EOF
$MSG
EOF

# 2.5 Vérifier la santé Repowise des fichiers modifiés dans ce commit (Non-bloquant)
powershell.exe -NoProfile -ExecutionPolicy Bypass -NonInteractive -Command "
try {
    \$repoRes = Invoke-RestMethod -Uri 'http://127.0.0.1:7337/api/repos' -TimeoutSec 1 -ErrorAction SilentlyContinue
    if (\$repoRes) {
        \$projName = & '$SCRIPTS/Get-ActiveProject.ps1'
        \$targetRepo = \$repoRes | Where-Object { \$_.name -eq \$projName -or \$_.workspace_alias -eq \$projName -or (\$projName -eq 'devcore' -and \$_.is_primary) } | Select-Object -First 1
        if (\$targetRepo) {
            \$health = Invoke-RestMethod -Uri \"http://127.0.0.1:7337/api/repos/\$(\$targetRepo.id)/health/overview\" -TimeoutSec 1 -ErrorAction SilentlyContinue
            if (\$health -and \$health.defect_accuracy -and \$health.defect_accuracy.flagged_files) {
                \$modified = git diff-tree --no-commit-id --name-only -r HEAD
                foreach (\$file in \$modified) {
                    \$matched = \$health.defect_accuracy.flagged_files | Where-Object { \$_.file_path -eq \$file -or \$_.file_path -replace '\\\\','/' -eq \$file }
                    if (\$matched -and \$matched.score -lt 3.0) {
                        Write-Host \"  [DEV_CORE Repowise] Warning : \$file est en zone d'alerte (Score: \$([math]::Round(\$matched.score, 2))/10). Pensez a refactorer ou ajouter un test.\" -ForegroundColor Yellow
                    }
                }
            }
        }
    }
} catch {}
"

# 3. Lancer le Scan + Sync + Dashboard et Repowise Update en arrière-plan (non-bloquant, asynchrone et robuste)
echo "  [DEV_CORE] Scan, synchronisation et Repowise Update en fond..."
powershell.exe -NoProfile -ExecutionPolicy Bypass -NonInteractive -Command "
Start-Process -FilePath 'powershell.exe' -ArgumentList '-NoProfile -ExecutionPolicy Bypass -NonInteractive -Command & \"$SCRIPTS/task_scan.ps1\"; & \"$SCRIPTS/task_sync.ps1\"' -WorkingDirectory '.' -WindowStyle Hidden
Start-Process -FilePath 'python.exe' -ArgumentList '\"$SCRIPTS/repowise_update.py\"' -WorkingDirectory '.' -WindowStyle Hidden
"

exit 0
