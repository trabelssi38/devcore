# DEV_CORE environment template
# Copy to .env locally or set these variables in your shell/user profile.
# Never commit real API keys or local tokens.

DEVCORE_PLATFORM_ROOT=C:\devcore\DEV_CORE
DEVCORE_DATA_ROOT=C:\devcore\DEV_CORE_DATA

# Gemini Router
# Preferred: set GEMINI_API_KEY in the environment.
# Optional legacy file fallback: DEV_CORE\Config\gemini_api_key.txt
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY_FILE=
NVIDIA_API_KEY=
CEREBRAS_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/v1

# Local router/client compatibility
NINEROUTER_API_KEY=
DEVCORE_ROUTER_TOKEN=
ANTHROPIC_BASE_URL=http://localhost:20128/v1
ANTHROPIC_AUTH_TOKEN=

# Services
REPOWISE_EXE=
REPOWISE_EMBEDDER=mock
